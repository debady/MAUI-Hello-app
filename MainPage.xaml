<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMauiApp.MainPage"
             Title="Ma première MAUI">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Bienvenue dans MAUI !" FontSize="24" HorizontalOptions="Center"/>
        <Entry x:Name="NameEntry" Placeholder="Ton prénom"/>
        <Button Text="Dire Bonjour" Clicked="OnGreetClicked"/>
        
        <Label x:Name="GreetingLabel" FontSize="18"/>
        <Button Text="Incrémenter compteur" Clicked="OnCountClicked"/>
        <Label x:Name="CountLabel" Text="Compteur: 0"/>
    </VerticalStackLayout>
</ContentPage>
